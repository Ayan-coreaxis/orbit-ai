# Copy to .env.local and fill in. Never commit real values.
# Most keys can also be set from Super Admin (/admin → API Keys, Storage, Web Search), which writes .env.local.

# --- required to run ---
# Postgres. Free options: Neon (neon.tech) or Supabase — paste the POOLED url here and the DIRECT url below
# (for a plain local Postgres both are the same, e.g. postgresql://postgres:postgres@localhost:5432/orbit).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/orbit?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/orbit?sslmode=require"
AUTH_SECRET=
ADMIN_PASSWORD=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shown on /privacy and /terms for data requests
LEGAL_CONTACT_EMAIL=

# --- Meta (Facebook / Instagram / Ads) ---
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Messenger / Instagram DMs → store chatbot: webhook https://<domain>/api/webhooks/meta with this token
META_WEBHOOK_VERIFY_TOKEN=
# Optional: Events Manager "Test events" code while checking the Conversions API
META_CAPI_TEST_CODE=

# --- platform billing (Stripe, the platform's own account) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# --- messaging / email ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
RESEND_API_KEY=
EMAIL_FROM=

# --- storage: Cloudflare R2 (empty = files stay in web/public/uploads) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- web search (Brave) + limits ---
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_COUNTRY=pk
WEB_SEARCH_PER_TURN=3
WEB_SEARCH_LIMIT_STARTER=300
WEB_SEARCH_LIMIT_GROWTH=600
WEB_SEARCH_LIMIT_SCALE=1500

# --- optional ---
OPENAI_API_KEY=        # Whisper transcripts for uploaded audio files
GOOGLE_TTS_API_KEY=    # natural voice for Orchestrator replies
APIFY_API_TOKEN=       # Instagram/TikTok competitor scraping
CRON_SECRET=
SENTRY_DSN=

# Orbit Studio (images + reels) — edit in Super Admin > Studio
GEMINI_API_KEY=            # Google AI Studio key — "Nano Banana 2" image model
SEEDANCE_API_KEY=          # BytePlus ModelArk key — Seedance 2.0 video model
STUDIO_ENABLED=true
STUDIO_IMAGE_MODEL=gemini-3.1-flash-image-preview
STUDIO_VIDEO_MODEL=dreamina-seedance-2-0-fast
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
STUDIO_VIDEO_RESOLUTION=720p
STUDIO_LIMIT_IMAGES_GROWTH=50
STUDIO_LIMIT_VIDEOS_GROWTH=5
STUDIO_LIMIT_IMAGES_SCALE=100
STUDIO_LIMIT_VIDEOS_SCALE=12

# Approved WhatsApp template Content SIDs (HX…) — easier to set in Super Admin > WhatsApp
TWILIO_TEMPLATE_ORDER_PLACED=
TWILIO_TEMPLATE_ORDER_CONFIRMED=
TWILIO_TEMPLATE_ORDER_SHIPPED=
TWILIO_TEMPLATE_VERIFY_ORDER=
TWILIO_TEMPLATE_REVIEW_REQUEST=
TWILIO_TEMPLATE_BACK_IN_STOCK=
TWILIO_TEMPLATE_CART_RECOVERY=
TWILIO_TEMPLATE_OTP=
TWILIO_TEMPLATE_OWNER_ALERT=

# WhatsApp webhook address override (only behind a proxy) — see Super Admin > WhatsApp
TWILIO_WEBHOOK_URL=

# Sellers' own store domains — see Settings > Domain and Super Admin > API Keys
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
STORE_DOMAIN_CNAME=        # VPS only, e.g. stores.orbit.pk
STORE_DOMAIN_IP=           # VPS only, your server's public IP
